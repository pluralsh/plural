{
  "name": "www",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:staging": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "analyze": "tsc && ANALYZE=true vite build",
    "start": "vite",
    "start:dev-api": "vite --mode dev-api",
    "start:prod": "yarn build:staging && serve -s -p 3001 build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "concurrently \"yarn lint:format\" \"yarn lint:js\" \"yarn lint:css\"",
    "lint:format": "prettier --check ./src",
    "lint:js": "eslint ./src",
    "lint:css": "stylelint src/**/*.css",
    "fix": "yarn fix:format && yarn fix:js && yarn fix:css",
    "fix:format": "prettier --write ./src",
    "fix:js": "eslint ./src --fix",
    "fix:css": "stylelint src/**/*.css --fix",
    "unimported": "npx unimported",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "postinstall": "node ./scripts/husky-install.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "@absinthe/socket": "0.2.1",
    "@apollo/client": "3.14.1",
    "@emotion/is-prop-valid": "1.4.0",
    "@nivo/core": "0.99.0",
    "@nivo/geo": "0.99.0",
    "@nivo/line": "0.99.0",
    "@pluralsh/design-system": "5.31.3",
    "@react-spring/web": "10.1.2",
    "@stripe/react-stripe-js": "3.1.1",
    "@stripe/stripe-js": "1.54.0",
    "@testing-library/react": "16.3.3",
    "apollo-absinthe-upload-link": "1.7.0",
    "babel-plugin-styled-components": "2.3.0",
    "country-code-lookup": "0.0.23",
    "cross-fetch": "4.1.0",
    "graphql": "16.14.2",
    "graphql-tag": "2.12.7",
    "history": "5.3.0",
    "js-cookie": "3.0.7",
    "lodash": "4.18.1",
    "memoize-one": "6.0.0",
    "moment": "2.31.0",
    "phoenix": "1.8.9",
    "pluralsh-absinthe-socket-apollo-link": "0.2.0",
    "prop-types": "15.8.1",
